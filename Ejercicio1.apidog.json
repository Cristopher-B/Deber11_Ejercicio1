  "projectTestCaseCategories": [
    {
      "id": 741814,
      "name": "Positivo",
      "description": "Entradas válidas y resultados esperados correctos, que representan un uso típico."
    },
    {
      "id": 741815,
      "name": "Negativo",
      "description": "Entradas negativas o no válidas, como campos faltantes, tipos incorrectos, métodos no admitidos, etc."
    },
    {
      "id": 741816,
      "name": "Límite",
